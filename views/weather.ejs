<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1a202c">
    <title><%= (site && site.title ? site.title : 'CCTV') %> — Cuaca</title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="/css/leaflet.css" />
    <script src="/js/leaflet.js"></script>
    <style>
        body { background-color: #1a202c; color: #cbd5e0; }
        #map { height: 520px; width: 100%; z-index: 1; border-radius: 0.5rem; border: 1px solid #374151; }
        @media (min-width: 768px) { #map { height: 650px; } }
    </style>
</head>
<body class="min-h-screen text-gray-200 font-sans">
    <nav class="bg-gray-900 border-b border-gray-700 px-4 py-3 sticky top-0 z-50">
        <div class="container mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="/" class="text-white font-bold text-lg"><%= (site && site.title ? site.title : 'CCTV') %></a>
                <span class="text-gray-500 text-sm hidden sm:inline">Cuaca • Angin • Ombak</span>
            </div>
            <div class="flex items-center gap-2">
                <a href="/"
                    class="bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded border border-gray-700 text-sm">Dashboard</a>
                <a href="/archive"
                    class="bg-blue-900 bg-opacity-40 hover:bg-opacity-60 text-blue-300 border border-blue-800 px-4 py-2 rounded text-sm">Arsip</a>
            </div>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2">
                <div class="bg-gray-800 rounded-lg border border-gray-700 p-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
                        <h2 class="text-white font-bold">Peta Kamera</h2>
                        <div class="flex flex-wrap items-center gap-3 text-sm">
                            <label class="inline-flex items-center gap-2 bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <input id="coastalOnly" type="checkbox" class="accent-cyan-500">
                                <span class="text-gray-200">Hanya pesisir (ombak)</span>
                            </label>
                            <button id="prefetchBtn"
                                class="bg-cyan-900 bg-opacity-40 hover:bg-opacity-60 text-cyan-300 border border-cyan-800 px-3 py-2 rounded">
                                Prefetch Cuaca
                            </button>
                        </div>
                    </div>
                    <div id="map"></div>
                    <div class="text-xs text-gray-400 mt-3">
                        Klik marker kamera untuk melihat prakiraan cuaca, kecepatan angin, dan ketinggian ombak di titik lokasi kamera.
                    </div>
                </div>
            </div>
            <div class="lg:col-span-1">
                <div class="bg-gray-800 rounded-lg border border-gray-700 p-4">
                    <h2 class="text-white font-bold mb-2">Info Lokasi</h2>
                    <div id="infoTitle" class="text-gray-300 text-sm mb-1">Pilih kamera di peta</div>
                    <div id="infoCoords" class="text-gray-500 text-xs mb-4"></div>

                    <div id="infoLoading" class="hidden text-gray-400 text-sm">Mengambil data cuaca...</div>
                    <div id="infoError" class="hidden text-red-400 text-sm"></div>

                    <div id="cards" class="space-y-3 hidden">
                        <div class="bg-gray-900 rounded border border-gray-700 p-3">
                            <div class="text-xs text-gray-400">Saat ini</div>
                            <div class="mt-1 grid grid-cols-2 gap-2 text-sm">
                                <div>
                                    <div class="text-gray-500 text-xs">Suhu</div>
                                    <div class="text-white font-semibold" id="curTemp">-</div>
                                </div>
                                <div>
                                    <div class="text-gray-500 text-xs">Angin</div>
                                    <div class="text-white font-semibold" id="curWind">-</div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900 rounded border border-gray-700 p-3">
                            <div class="text-xs text-gray-400">Ombak (prakiraan)</div>
                            <div class="mt-1 grid grid-cols-2 gap-2 text-sm">
                                <div>
                                    <div class="text-gray-500 text-xs">Tinggi ombak</div>
                                    <div class="text-white font-semibold" id="curWave">-</div>
                                </div>
                                <div>
                                    <div class="text-gray-500 text-xs">Periode</div>
                                    <div class="text-white font-semibold" id="curWavePeriod">-</div>
                                </div>
                            </div>
                            <div class="text-gray-500 text-xs mt-2" id="curWaveHint"></div>
                        </div>

                        <div class="bg-gray-900 rounded border border-gray-700 p-3">
                            <div class="text-xs text-gray-400">6 Jam ke depan</div>
                            <div class="mt-2 space-y-2" id="nextHours"></div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-900 rounded-lg border border-gray-700 p-4 mt-6 text-xs text-gray-500">
                    Sumber data: Open-Meteo (tanpa API key). Data ombak tersedia bila endpoint marine memiliki cakupan untuk koordinat tersebut.
                </div>
            </div>
        </div>
    </main>

    <script type="application/json" id="cameras-json"><%- JSON.stringify(cameras || []) %></script>
    <script>
        const cameras = JSON.parse(document.getElementById('cameras-json').textContent || '[]');
        let map = null;
        const weatherCache = new Map();
        let coastalOnly = false;
        let prefetchInFlight = false;

        function degToCompass(deg) {
            if (typeof deg !== 'number' || isNaN(deg)) return '-';
            const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
            const idx = Math.round(deg / 45) % 8;
            return dirs[idx];
        }

        function setLoading(loading) {
            const el = document.getElementById('infoLoading');
            if (loading) el.classList.remove('hidden');
            else el.classList.add('hidden');
        }

        function setError(msg) {
            const el = document.getElementById('infoError');
            if (msg) {
                el.textContent = msg;
                el.classList.remove('hidden');
            } else {
                el.textContent = '';
                el.classList.add('hidden');
            }
        }

        function showCards(show) {
            const el = document.getElementById('cards');
            if (show) el.classList.remove('hidden');
            else el.classList.add('hidden');
        }

        function pickNearestIndex(times, isoNow) {
            if (!Array.isArray(times) || !isoNow) return -1;
            const now = new Date(isoNow).getTime();
            if (!isFinite(now)) return -1;
            let best = -1;
            let bestDiff = Infinity;
            for (let i = 0; i < times.length; i++) {
                const t = new Date(times[i]).getTime();
                if (!isFinite(t)) continue;
                const d = Math.abs(t - now);
                if (d < bestDiff) {
                    bestDiff = d;
                    best = i;
                }
            }
            return best;
        }

        function buildPopupHtml(cam, summary) {
            const title = `<div style="font-weight:800;color:#111827;background:#ffffff;padding:6px 8px;border-radius:8px;display:inline-block;">${cam.nama || 'Kamera'}</div>`;
            const lokasi = `<div style="font-size:13px;color:#6b7280;margin-top:6px;">${cam.lokasi || ''}</div>`;

            if (!summary) {
                return `<div style="min-width:240px;">${title}${lokasi}<div style="margin-top:10px;font-size:14px;color:#e5e7eb;line-height:1.5;">Klik untuk lihat cuaca</div></div>`;
            }

            const waveLine = summary.waveText !== '-' ? `Ombak: <b>${summary.waveText}</b>` : 'Ombak: -';
            const waveHint = summary.waveHint ? `<div style="margin-top:6px;color:#9ca3af;font-size:12px;">${summary.waveHint}</div>` : '';
            return `<div style="min-width:240px;">${title}${lokasi}` +
                `<div style="margin-top:10px;font-size:14px;color:#e5e7eb;line-height:1.5;">` +
                `<div>Suhu: <b>${summary.temp}</b></div>` +
                `<div>Angin: <b>${summary.windSpeed}</b> • ${summary.windDir}</div>` +
                `<div>${waveLine}</div>` +
                `${waveHint}` +
                `</div>` +
                `</div>`;
        }

        async function getWeatherSummary(cam) {
            const key = `${cam.lat},${cam.lng}`;
            const cached = weatherCache.get(key);
            const now = Date.now();
            if (cached && (now - cached.at) < 10 * 60 * 1000) return cached.summary;

            const url = `/api/weather?lat=${encodeURIComponent(cam.lat)}&lng=${encodeURIComponent(cam.lng)}`;
            const res = await fetch(url);
            const json = await res.json();
            if (!res.ok || !json.success) throw new Error(json.message || 'Gagal mengambil data cuaca');

            const data = json.data || {};
            const cur = data.current || {};
            const temp = (typeof cur.temperature_2m === 'number') ? `${cur.temperature_2m.toFixed(1)}°C` : '-';
            const windSpeed = (typeof cur.wind_speed_10m === 'number') ? `${cur.wind_speed_10m.toFixed(0)} km/jam` : '-';
            const windDir = (typeof cur.wind_direction_10m === 'number') ? `${degToCompass(cur.wind_direction_10m)} (${cur.wind_direction_10m.toFixed(0)}°)` : '-';

            const mh = data.marine_hourly || null;
            let waveText = '-';
            let waveHint = '';
            let hasMarine = false;
            if (mh && Array.isArray(mh.time)) {
                const idx = pickNearestIndex(mh.time, cur.time);
                if (idx >= 0) {
                    const h = mh.wave_height && typeof mh.wave_height[idx] === 'number' ? mh.wave_height[idx] : null;
                    const d = mh.wave_direction && typeof mh.wave_direction[idx] === 'number' ? mh.wave_direction[idx] : null;
                    if (h !== null) {
                        hasMarine = true;
                        waveText = `${h.toFixed(1)} m`;
                    }
                    if (d !== null) {
                        waveHint = `Arah ombak: ${degToCompass(d)} (${d.toFixed(0)}°)`;
                    }
                }
            }

            const summary = { temp, windSpeed, windDir, waveText, waveHint, hasMarine };
            weatherCache.set(key, { at: now, summary });
            return summary;
        }

        function applyMarkerVisibility() {
            cameras.forEach(cam => {
                if (!cam._marker) return;
                const ok = !coastalOnly || cam._hasMarine === true;
                if (ok) {
                    if (!map.hasLayer(cam._marker)) cam._marker.addTo(map);
                } else {
                    if (map.hasLayer(cam._marker)) cam._marker.removeFrom(map);
                }
            });
        }

        async function loadWeather(cam) {
            document.getElementById('infoTitle').textContent = cam.nama || 'Kamera';
            document.getElementById('infoCoords').textContent = `${cam.lokasi || ''} • ${cam.lat}, ${cam.lng}`;

            setError('');
            showCards(false);
            setLoading(true);

            try {
                const url = `/api/weather?lat=${encodeURIComponent(cam.lat)}&lng=${encodeURIComponent(cam.lng)}`;
                const res = await fetch(url);
                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Gagal mengambil data cuaca');

                const data = json.data || {};
                const cur = data.current || {};

                const temp = (typeof cur.temperature_2m === 'number') ? `${cur.temperature_2m.toFixed(1)}°C` : '-';
                const windSpeed = (typeof cur.wind_speed_10m === 'number') ? `${cur.wind_speed_10m.toFixed(0)} km/jam` : '-';
                const windDir = (typeof cur.wind_direction_10m === 'number') ? `${degToCompass(cur.wind_direction_10m)} (${cur.wind_direction_10m.toFixed(0)}°)` : '-';

                document.getElementById('curTemp').textContent = temp;
                document.getElementById('curWind').textContent = `${windSpeed} • ${windDir}`;

                const mh = data.marine_hourly || null;
                let waveText = '-';
                let wavePeriodText = '-';
                let waveHint = '';
                if (mh && Array.isArray(mh.time)) {
                    const idx = pickNearestIndex(mh.time, cur.time);
                    if (idx >= 0) {
                        const h = mh.wave_height && typeof mh.wave_height[idx] === 'number' ? mh.wave_height[idx] : null;
                        const p = mh.wave_period && typeof mh.wave_period[idx] === 'number' ? mh.wave_period[idx] : null;
                        const d = mh.wave_direction && typeof mh.wave_direction[idx] === 'number' ? mh.wave_direction[idx] : null;
                        if (h !== null) waveText = `${h.toFixed(1)} m`;
                        if (p !== null) wavePeriodText = `${p.toFixed(0)} s`;
                        if (d !== null) waveHint = `Arah ombak: ${degToCompass(d)} (${d.toFixed(0)}°)`;
                    }
                } else {
                    waveHint = 'Data ombak tidak tersedia untuk koordinat ini.';
                }

                document.getElementById('curWave').textContent = waveText;
                document.getElementById('curWavePeriod').textContent = wavePeriodText;
                document.getElementById('curWaveHint').textContent = waveHint;

                const summary = await getWeatherSummary(cam);
                cam._hasMarine = !!summary.hasMarine;
                applyMarkerVisibility();

                if (cam._marker) {
                    const popup = cam._marker.getPopup();
                    if (popup) popup.setContent(buildPopupHtml(cam, summary));
                }

                const hourly = data.hourly || {};
                const nextHoursEl = document.getElementById('nextHours');
                nextHoursEl.innerHTML = '';
                if (hourly && Array.isArray(hourly.time)) {
                    const idx = pickNearestIndex(hourly.time, cur.time);
                    const start = Math.max(0, idx);
                    const end = Math.min(hourly.time.length, start + 6);
                    for (let i = start; i < end; i++) {
                        const t = new Date(hourly.time[i]);
                        const hh = String(t.getHours()).padStart(2, '0') + ':00';
                        const w = hourly.wind_speed_10m && typeof hourly.wind_speed_10m[i] === 'number' ? hourly.wind_speed_10m[i] : null;
                        const wd = hourly.wind_direction_10m && typeof hourly.wind_direction_10m[i] === 'number' ? hourly.wind_direction_10m[i] : null;
                        const line = document.createElement('div');
                        line.className = 'flex items-center justify-between text-sm';
                        line.innerHTML = `<span class="text-gray-400">${hh}</span><span class="text-white font-semibold">${w !== null ? w.toFixed(0) : '-'} km/jam ${wd !== null ? '• ' + degToCompass(wd) : ''}</span>`;
                        nextHoursEl.appendChild(line);
                    }
                }

                showCards(true);
            } catch (e) {
                setError(e.message || 'Terjadi kesalahan');
            } finally {
                setLoading(false);
            }
        }

        function initMap() {
            let center = [-6.2088, 106.8456];
            const validCam = cameras.find(c => c.lat && c.lng);
            if (validCam) center = [Number(validCam.lat), Number(validCam.lng)];

            map = L.map('map').setView(center, 9);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            function makeIcon() {
                return L.divIcon({
                    className: '',
                    html:
                        '<div style="' +
                        'width:30px;height:30px;border-radius:9999px;' +
                        'background:linear-gradient(135deg,#06b6d4 0%,#0ea5e9 100%);' +
                        'border:2px solid #164e63;' +
                        'box-shadow:0 6px 16px rgba(14,165,233,.35);' +
                        'display:flex;align-items:center;justify-content:center;' +
                        '">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white" viewBox="0 0 24 24">' +
                        '<path d="M4 7a3 3 0 0 1 3-3h2l1.2-1.6A2 2 0 0 1 12 1h4a2 2 0 0 1 1.6.8L19 4h2a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7zm8 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>' +
                        '</svg>' +
                        '</div>',
                    iconSize: [30, 30],
                    iconAnchor: [15, 15],
                    popupAnchor: [0, -16]
                });
            }

            cameras.forEach(cam => {
                if (!cam.lat || !cam.lng) return;
                const marker = L.marker([Number(cam.lat), Number(cam.lng)], { icon: makeIcon() }).addTo(map);
                cam._marker = marker;
                marker.bindPopup(buildPopupHtml(cam, null));
                marker.on('click', () => loadWeather(cam));
                marker.on('popupopen', async () => {
                    try {
                        const summary = await getWeatherSummary(cam);
                        cam._hasMarine = !!summary.hasMarine;
                        applyMarkerVisibility();
                        const popup = marker.getPopup();
                        if (popup) popup.setContent(buildPopupHtml(cam, summary));
                    } catch { }
                });
            });

            if (validCam) loadWeather(validCam);
        }

        async function prefetchAllWeather() {
            if (prefetchInFlight) return;
            prefetchInFlight = true;
            const btn = document.getElementById('prefetchBtn');
            if (btn) btn.disabled = true;

            try {
                const queue = cameras.filter(c => c.lat && c.lng);
                const concurrency = 3;
                let idx = 0;

                async function worker() {
                    while (idx < queue.length) {
                        const cam = queue[idx++];
                        try {
                            const summary = await getWeatherSummary(cam);
                            cam._hasMarine = !!summary.hasMarine;
                        } catch { }
                    }
                }

                await Promise.all(new Array(concurrency).fill(0).map(worker));
                applyMarkerVisibility();
            } finally {
                prefetchInFlight = false;
                if (btn) btn.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', initMap);
        document.getElementById('coastalOnly')?.addEventListener('change', (e) => {
            coastalOnly = !!e.target.checked;
            applyMarkerVisibility();
        });
        document.getElementById('prefetchBtn')?.addEventListener('click', () => {
            prefetchAllWeather();
        });
    </script>
</body>
</html>
