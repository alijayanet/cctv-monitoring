<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f172a">
    <link rel="manifest" href="<%= base_path %>/manifest.json">
    <link rel="icon" href="<%= base_path %>/icon-192x192.png">
    <link rel="apple-touch-icon" href="<%= base_path %>/icon-192x192.png">
    <title><%= site.title %> - Live Dashboard</title>
    
    <!-- Fonts & CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'marquee': 'marquee 30s linear infinite',
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                    },
                    keyframes: {
                        marquee: { '0%': { transform: 'translateX(100%)' }, '100%': { transform: 'translateX(-100%)' } },
                        fadeIn: { '0%': { opacity: '0', transform: 'translateY(10px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="<%= base_path %>/css/modern.css">
    <link rel="stylesheet" href="<%= base_path %>/css/leaflet.css" />
    
    <style>
        body { background-color: #020617; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .glass-panel { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.05); }
        .sidebar-scroll::-webkit-scrollbar { width: 4px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
        
        .live-grid { display: grid; gap: 1rem; width: 100%; transition: all 0.3s ease; }
        .grid-1 { grid-template-columns: 1fr; width: 100%; margin: 0 auto; height: 100%; }
        .grid-2 { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; width: 100%; }
        
        @media (min-width: 1024px) {
            .grid-1 { max-width: 100%; height: auto; aspect-ratio: 16/9; }
        }

        .video-wrapper { position: relative; width: 100%; height: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 0; overflow: hidden; border: 1px solid #1e293b; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5); }
        .video-wrapper video { width: 100%; height: 100%; object-fit: cover; }
        @media (min-width: 1024px) {
            .video-wrapper video { object-fit: contain; }
        }
        
        .empty-slot { aspect-ratio: 16 / 9; background: #000; display: flex; align-items: center; justify-content: center; color: #1e293b; border-radius: 0.75rem; border: 1px dashed #1e293b; }
        .camera-item.selected { border-color: #10b981; background: rgba(16, 185, 129, 0.05); }
        
        .nav-tab { transition: all 0.2s ease; cursor: pointer; }
        .nav-tab:hover { background: rgba(255,255,255,0.05); }
        .nav-tab.active { background: #10b981; color: #020617; }
        .custom-div-icon { background: none !important; border: none !important; }
        .blink { animation: blink 1s steps(5, start) infinite; }
        @keyframes blink { to { visibility: hidden; } }
    </style>
    
    <script src="<%= base_path %>/js/hls.min.js"></script>
    <script src="<%= base_path %>/js/leaflet.js"></script>
</head>
<body class="antialiased h-screen flex flex-col overflow-hidden">
    <%- include('partials/global_modal') %>

    <!-- Time Modal (Mobile) -->
    <div id="timeModal" onclick="closeTimeModal()" class="fixed inset-0 z-[110] hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md animate-fade-in">
        <div onclick="event.stopPropagation()" class="bg-slate-900 border border-slate-800 w-full max-w-xs rounded-3xl shadow-2xl overflow-hidden p-8 flex flex-col items-center gap-6">
            <div class="w-16 h-16 bg-emerald-500/10 rounded-2xl flex items-center justify-center">
                <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div class="text-center">
                <h2 id="modal-clock" class="text-4xl font-black text-white tracking-tighter mb-1">00:00:00</h2>
                <p id="modal-date" class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em]">01 Januari 2026</p>
            </div>
            <div class="w-full h-px bg-slate-800"></div>
            <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-emerald-500 rounded-full blink"></div>
                <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest">Server Live Status</span>
            </div>
            <button onclick="closeTimeModal()" class="mt-4 w-full py-3 bg-slate-800 text-white text-[10px] font-black rounded-xl uppercase tracking-widest hover:bg-slate-700 transition">Tutup</button>
        </div>
    </div>

    <!-- Header Navigation -->
    <nav class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex-none h-14 lg:h-16 flex items-center z-50">
        <div class="w-full px-6 flex justify-between items-center gap-4">
            <!-- Brand -->
            <div class="flex items-center gap-4 flex-none cursor-pointer" onclick="window.location.href='<%= base_path %>/'">
                <div class="p-2 bg-emerald-500/20 rounded-lg hidden sm:block">
                    <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-sm font-black text-white tracking-tight uppercase leading-none"><%= site.title %></h1>
                    <p class="text-[9px] text-slate-500 font-bold uppercase tracking-widest mt-1"><%= site.footer %></p>
                </div>
            </div>

            <!-- Central Area (Desktop Only) -->
            <div class="hidden lg:flex flex-1 items-center justify-center gap-4">
                <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <button onclick="switchMode('live')" id="tab-live" class="nav-tab active px-4 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-all">Live</button>
                    <button onclick="switchMode('map')" id="tab-map" class="nav-tab px-4 py-1.5 rounded-lg text-[10px] font-bold text-slate-500 uppercase tracking-widest transition-all">Peta</button>
                </div>
            </div>

            <!-- User/Weather -->
            <div class="flex items-center gap-2 lg:gap-3 flex-none">
                <!-- Desktop Clock & Status -->
                <div class="hidden lg:flex items-center gap-4 px-4 py-1.5 bg-slate-950/50 rounded-xl border border-slate-800/50 mr-2">
                    <div class="flex items-center gap-3">
                        <span id="topbar-clock" class="text-sm font-black text-white leading-none tracking-tighter">00:00:00</span>
                        <div class="w-px h-3 bg-slate-800"></div>
                        <span id="topbar-date" class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">01 Januari 2026</span>
                    </div>
                    <div class="h-6 w-px bg-slate-800"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-emerald-500 rounded-full blink"></div>
                        <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest">Server Live</span>
                    </div>
                </div>

                <!-- Mobile Date Button -->
                <button onclick="showTimeModal()" class="lg:hidden flex items-center justify-center w-9 h-9 bg-slate-800 text-white rounded-xl border border-slate-700 shadow-lg active:scale-95 transition">
                    <span id="mobile-date-num" class="text-sm font-black"><%= new Date().getDate() %></span>
                </button>

                <div id="weather-widget" onclick="showWeatherDetail()" class="flex items-center gap-2 px-3 py-1.5 bg-slate-800/50 hover:bg-slate-700/50 cursor-pointer rounded-xl border border-slate-700/50 transition duration-300">
                    <span id="weather-icon" class="text-sm">🌤️</span>
                    <span id="weather-temp" class="text-xs font-bold text-slate-200">--°C</span>
                </div>
                
                <div class="hidden lg:flex items-center gap-1">
                    <a href="<%= base_path %>/archive" class="px-3 py-2 text-[10px] font-bold text-slate-400 hover:text-white uppercase tracking-widest transition">REKAMAN</a>
                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                        <a href="<%= base_path %>/admin" class="px-3 py-2 text-[10px] font-bold text-emerald-400 hover:text-emerald-300 uppercase tracking-widest transition">Admin</a>
                        <a href="<%= base_path %>/user/logout" class="ml-1 px-3 py-1.5 bg-rose-500/10 text-rose-500 text-[10px] font-black rounded-lg hover:bg-rose-500 hover:text-white transition uppercase tracking-widest">Logout</a>
                    <% } else if (typeof isCustomer !== 'undefined' && isCustomer) { %>
                        <span onclick="window.location.href='<%= base_path %>/user/account'" class="hidden md:block text-[10px] font-bold text-emerald-400 hover:text-emerald-300 cursor-pointer uppercase tracking-widest mx-2"><%= (customer.full_name || customer.username).toUpperCase() %></span>
                        <a href="<%= base_path %>/user/logout" class="px-3 py-1.5 bg-rose-500/10 text-rose-500 text-[10px] font-black rounded-lg hover:bg-rose-500 hover:text-white transition uppercase tracking-widest">Logout</a>
                    <% } else { %>
                        <a href="<%= base_path %>/user/login" class="ml-2 px-4 py-2 bg-emerald-600 text-white text-[10px] font-black rounded-xl hover:bg-emerald-500 transition shadow-lg shadow-emerald-500/20 uppercase tracking-widest">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Mobile Bottom Navigation -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 h-14 bg-slate-900/95 backdrop-blur-xl border-t border-slate-800 flex items-center justify-around px-2 z-[100] shadow-[0_-10px_30px_-15px_rgba(0,0,0,0.5)]">
        <button onclick="switchMode('live')" id="m-tab-live" class="flex flex-col items-center gap-1 px-3 group">
            <div class="p-1.5 rounded-xl bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300" id="m-icon-live">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            </div>
            <span class="text-[8px] font-black text-emerald-500 uppercase tracking-widest" id="m-text-live">Live</span>
        </button>
        
        <button onclick="switchMode('map')" id="m-tab-map" class="flex flex-col items-center gap-1 px-3 group">
            <div class="p-1.5 rounded-xl text-slate-500 transition-all duration-300" id="m-icon-map">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m6 13l5.447-2.724A1 1 0 0121 18.382V7.618a1 1 0 01-1.447-.894L15 9m-6 11V7m6 11V9"></path></svg>
            </div>
            <span class="text-[8px] font-black text-slate-500 uppercase tracking-widest" id="m-text-map">Peta</span>
        </button>

        <% if (typeof isCustomer !== 'undefined' && isCustomer || typeof isAdmin !== 'undefined' && isAdmin) { %>
            <a href="<%= base_path %>/archive" class="flex flex-col items-center gap-1 px-3 group">
                <div class="p-1.5 rounded-xl text-slate-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="text-[8px] font-black text-slate-500 uppercase tracking-widest">Rekaman</span>
            </a>

            <button onclick="window.location.href='<%= base_path %>/user/account'" class="flex flex-col items-center gap-1 px-3 group">
                <div class="p-1.5 rounded-xl text-slate-500 transition-all duration-300" id="m-icon-account">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                </div>
                <span class="text-[8px] font-black text-slate-500 uppercase tracking-widest" id="m-text-account">Akun</span>
            </button>

            <button onclick="openReportModal()" class="flex flex-col items-center gap-1 px-3 group text-amber-500">
                <div class="p-1.5 rounded-xl text-amber-500/50 group-hover:text-amber-500 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <span class="text-[8px] font-black uppercase tracking-widest">Lapor</span>
            </button>
        <% } else { %>
            <a href="<%= base_path %>/user/login" class="flex flex-col items-center gap-1 px-3 group text-emerald-500">
                <div class="p-1.5 rounded-xl bg-emerald-500/10 text-emerald-500 transition-all duration-300">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                </div>
                <span class="text-[8px] font-black uppercase tracking-widest">Login</span>
            </a>
        <% } %>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">
        <main class="flex-1 flex flex-col overflow-hidden bg-slate-950 relative">
            <div id="main-content-display" class="flex-none lg:flex-1 overflow-hidden relative flex flex-col items-center justify-center p-0 lg:p-4 bg-black">
                <div id="live-display" class="w-full flex flex-col gap-3">
                    <div id="live-grid" class="live-grid grid-1">
                        <div class="empty-slot animate-fade-in flex-col gap-4">
                            <svg class="w-12 h-12 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            <p class="text-xs font-black uppercase tracking-widest text-slate-800">Pilih Kamera</p>
                        </div>
                    </div>
                    <% if (site.running_text) { %>
                    <div class="w-full bg-slate-900/50 border border-slate-800 rounded-xl overflow-hidden flex items-center shadow-lg backdrop-blur-sm">
                        <div class="bg-emerald-600 text-slate-950 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest z-10 flex-none shadow-[10px_0_20px_-5px_rgba(0,0,0,0.5)] flex items-center gap-2">
                            <div class="w-1.5 h-1.5 bg-slate-950 rounded-full animate-pulse"></div>
                            INFO
                        </div>
                        <div class="flex-1 overflow-hidden relative flex items-center h-full">
                            <div class="animate-marquee whitespace-nowrap px-4 py-2">
                                <p class="text-xs font-bold text-slate-300 inline-block">
                                    <%= site.running_text %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
                <div id="map-display" class="hidden w-full h-full animate-fade-in absolute inset-0 p-0 lg:p-4">
                    <div id="map" class="w-full h-full lg:rounded-2xl border-b lg:border border-slate-800 overflow-hidden"></div>
                </div>
            </div>

            <!-- Mobile List (Hidden on desktop) -->
            <div id="mobile-list-container" class="lg:hidden flex-1 overflow-y-auto p-4 space-y-4 bg-slate-900/50 border-t border-slate-800 pb-24 sidebar-scroll">
                <div class="relative">
                    <input type="text" id="mobile-search" placeholder="Cari Kamera..." 
                        class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-xs text-white focus:outline-none pl-10 uppercase font-bold">
                    <svg class="w-4 h-4 text-slate-600 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <div id="mobile-camera-list" class="space-y-2 pb-24">
                    <!-- Cloned from JS -->
                </div>
            </div>
        </main>

        <!-- Sidebar Section (Desktop Only) -->
        <aside class="hidden lg:flex w-[420px] bg-slate-900 border-l border-slate-800 flex-col flex-none shadow-2xl z-40">
            <div class="p-5 border-b border-slate-800">
                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest">Daftar Kamera</h3>
            </div>
            <div class="p-4 border-b border-slate-800">
                <div class="relative">
                    <input type="text" id="camera-search" placeholder="Cari..." class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-xs text-white focus:outline-none pl-10">
                    <svg class="w-4 h-4 text-slate-600 absolute left-4 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
            </div>
            <div id="camera-list" class="flex-1 overflow-y-auto sidebar-scroll p-4 space-y-3">
                <% cameras.forEach(camera => { %>
                <div class="camera-item glass-panel p-3 rounded-xl border border-slate-800 hover:border-emerald-500/30 transition group cursor-pointer" 
                    data-id="<%= camera.id %>" data-nama="<%= camera.nama.toLowerCase() %>" onclick="toggleCameraSelection('<%= camera.id %>')">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-slate-950 rounded-lg flex items-center justify-center border border-slate-800 overflow-hidden">
                            <svg class="w-5 h-5 text-slate-700 group-hover:text-emerald-500 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <h4 class="text-[11px] font-black text-slate-200 truncate"><%= camera.nama %></h4>
                                <% if (!camera.isPlayable) { %>
                                    <svg class="w-3 h-3 text-rose-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                                <% } %>
                            </div>
                            <p class="text-[9px] text-sky-400 font-bold uppercase truncate tracking-wide"><%= camera.lokasi || 'Live' %></p>
                            <span class="text-[7px] font-bold <%= camera.isPlayable ? 'text-emerald-500' : 'text-rose-500' %> uppercase tracking-widest mt-1 block">
                                <%= (camera.level || 'umum').toUpperCase() %>
                            </span>
                        </div>
                        <div class="status-indicator hidden w-2 h-2 rounded-full bg-emerald-500 shadow-lg shadow-emerald-500/50"></div>
                    </div>
                </div>
                <% }) %>
            </div>
        </aside>
    </div>

    <!-- Weather Modal -->
    <div id="weatherModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-fade-in">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden">
            <div class="p-6 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-emerald-500/20 rounded-xl"><svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg></div>
                    <div><h3 class="text-sm font-bold text-white">Detail Cuaca</h3></div>
                </div>
                <button onclick="closeWeatherModal()" class="p-2 hover:bg-slate-800 rounded-xl text-slate-500 transition"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg></button>
            </div>
            <div class="p-8 space-y-8">
                <div id="modal-weather-content" class="flex flex-col gap-6"></div>
            </div>
        </div>
    </div>

    <!-- Incident Report Modal -->
    <div id="reportModal" class="fixed inset-0 z-[110] hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-fade-in">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden">
            <div class="p-6 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-500/20 rounded-xl"><svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg></div>
                    <h3 class="text-sm font-black text-white uppercase tracking-widest">Buat Laporan Kejadian</h3>
                </div>
                <button onclick="closeReportModal()" class="p-2 hover:bg-slate-800 rounded-xl text-slate-500 transition"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg></button>
            </div>
            <form id="reportForm" class="p-8 space-y-6">
                <div>
                    <label class="block text-[10px] font-black text-slate-500 mb-2 uppercase tracking-widest">Pilih Kamera</label>
                    <select name="camera_id" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-xs focus:border-emerald-500 transition-all">
                        <option value="">-- Pilih Lokasi --</option>
                        <% cameras.forEach(cam => { %>
                            <option value="<%= cam.id %>"><%= cam.nama %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 mb-2 uppercase tracking-widest">Kategori Laporan</label>
                    <select name="category" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-xs focus:border-emerald-500 transition-all">
                        <option value="Kriminalitas">Kriminalitas / Pencurian</option>
                        <option value="Lalu Lintas">Kecelakaan Lalu Lintas</option>
                        <option value="Kebakaran">Kebakaran</option>
                        <option value="Bencana Alam">Bencana Alam</option>
                        <option value="Sampah">Tumpukan Sampah</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 mb-2 uppercase tracking-widest">Deskripsi Kejadian</label>
                    <textarea name="description" required rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-xs focus:border-emerald-500 transition-all" placeholder="Jelaskan detail kejadian..."></textarea>
                </div>
                <button type="submit" class="w-full py-4 bg-emerald-600 text-white text-xs font-black uppercase rounded-2xl shadow-xl shadow-emerald-500/20 hover:bg-emerald-500 transition tracking-widest">Kirim Laporan</button>
            </form>
        </div>
    </div>

    <script id="cameras-data" type="application/json"><%- JSON.stringify(cameras) %></script>
    <script>
        const cameras = JSON.parse(document.getElementById('cameras-data').textContent);
        const basePath = '<%= base_path %>';
        const hlsPort = '<%= (typeof mediamtx !== "undefined" ? mediamtx.hls_port : "8856") %>';
        const hlsBase = '<%= hlsBaseUrl %>';
        const userStatus = JSON.parse('<%- typeof userStatus !== "undefined" ? userStatus : JSON.stringify({isAdmin:false,isCustomer:false}) %>');
        
        let selectedCameraIds = [];
        let viewMode = 'live';
        let hlsInstances = {};
        let map = null;

        // --- Core Functions ---
        function toggleCameraSelection(id) {
            const isMobile = window.innerWidth < 1024;
            if (isMobile) {
                selectedCameraIds = [String(id)];
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                const idx = selectedCameraIds.indexOf(String(id));
                if (idx === -1) {
                    if (selectedCameraIds.length >= 4) return;
                    selectedCameraIds.push(String(id));
                } else {
                    selectedCameraIds.splice(idx, 1);
                }
            }
            updateGrid();
            renderMobileList();
            saveState();
        }

        function updateGrid() {
            const grid = document.getElementById('live-grid');
            const count = selectedCameraIds.length;
            
            // Kill old streams
            Object.values(hlsInstances).forEach(h => h.destroy());
            hlsInstances = {};

            // Update Desktop UI sidebar
            document.querySelectorAll('#camera-list .camera-item').forEach(el => {
                const isSelected = selectedCameraIds.includes(el.dataset.id);
                el.classList.toggle('selected', isSelected);
                el.querySelector('.status-indicator').classList.toggle('hidden', !isSelected);
            });

            if (count === 0) {
                grid.className = 'live-grid grid-1';
                grid.innerHTML = `<div class="empty-slot animate-fade-in flex-col gap-4">
                    <svg class="w-12 h-12 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    <p class="text-xs font-black uppercase tracking-widest text-slate-800">Pilih Kamera</p>
                </div>`;
                return;
            }

            grid.className = `live-grid ${ (count === 1) ? 'grid-1' : 'grid-2' }`;
            grid.innerHTML = selectedCameraIds.map(id => `
                <div class="video-wrapper group relative bg-black aspect-video rounded-none overflow-hidden border border-slate-900 flex items-center justify-center">
                    <video id="video-${id}" class="w-full h-full object-cover lg:object-contain" playsinline autoplay muted></video>
                    <!-- Label -->
                    <div class="absolute top-2 left-2 px-2 py-1 bg-slate-950/80 rounded text-[8px] font-black text-emerald-500 uppercase border border-emerald-500/20">${cameras.find(c => String(c.id) === id)?.nama}</div>
                    <!-- Controls Overlay -->
                    <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity flex gap-2">
                        <button onclick="toggleFullscreen('video-${id}')" class="p-1.5 bg-slate-950/80 text-white rounded-lg hover:bg-emerald-600 transition shadow-xl border border-white/10">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
                        </button>
                    </div>
                </div>
            `).join('');

            selectedCameraIds.forEach(id => {
                const cam = cameras.find(c => String(c.id) === id);
                if (!cam) return;

                const v = document.getElementById(`video-${id}`);
                const wrapper = v.closest('.video-wrapper');

                if (!cam.isPlayable) {
                    wrapper.innerHTML = `
                        <div class="absolute inset-0 bg-slate-900/90 flex flex-col items-center justify-center p-6 text-center">
                            <svg class="w-10 h-10 text-rose-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            <h4 class="text-[10px] font-black text-white uppercase tracking-widest mb-1">${cam.nama} TERKUNCI</h4>
                            <p class="text-[8px] text-slate-400 uppercase mb-4">Butuh Level ${cam.level.toUpperCase()}</p>
                            <a href="${basePath}/user/login" class="px-4 py-2 bg-emerald-600 text-white text-[8px] font-black rounded-lg uppercase tracking-widest">Upgrade / Login</a>
                        </div>
                    `;
                    return;
                }

                const primaryUrl = `${hlsBase}/cam_${id}/index.m3u8`;
                const fallbackUrl = `${hlsBase}/cam_${id}_input/index.m3u8`;
                
                function startHls(url, isFallback = false) {
                    if (hlsInstances[id]) hlsInstances[id].destroy();
                    if (Hls.isSupported()) {
                        const hls = new Hls({ manifestLoadingMaxRetry: isFallback ? 5 : 2, manifestLoadingRetryDelay: 1000 });
                        hls.loadSource(url);
                        hls.attachMedia(v);
                        hls.on(Hls.Events.MANIFEST_PARSED, () => v.play().catch(() => {}));
                        hls.on(Hls.Events.ERROR, (e, d) => {
                            if (d.fatal && !isFallback) startHls(fallbackUrl, true);
                        });
                        hlsInstances[id] = hls;
                    } else if (v.canPlayType('application/vnd.apple.mpegurl')) {
                        v.src = url;
                        v.play().catch(() => { if (!isFallback) { v.src = fallbackUrl; v.play().catch(() => {}); } });
                    }
                }
                startHls(primaryUrl);
            });
        }

        function renderMobileList() {
            const list = document.getElementById('mobile-camera-list');
            if (!list) return;
            
            const userLevel = (userStatus.customerLevel || 'umum').toLowerCase();
            
            list.innerHTML = cameras.map(cam => {
                const camLevel = (cam.level || 'umum').toLowerCase();
                let canView = userStatus.isAdmin || userLevel === 'admin';
                
                if (!canView) {
                    const hierarchy = ['umum', 'member', 'vip', 'vvip', 'pemerintahan'];
                    const uIdx = hierarchy.indexOf(userLevel);
                    const cIdx = hierarchy.indexOf(camLevel);
                    if (camLevel === 'umum') canView = true;
                    else if (uIdx !== -1 && cIdx !== -1 && uIdx >= cIdx) canView = true;
                }

                const isSelected = selectedCameraIds.includes(String(cam.id));
                const levelColors = {
                    'umum': 'text-emerald-500',
                    'member': 'text-blue-500',
                    'vip': 'text-purple-500',
                    'vvip': 'text-orange-500',
                    'pemerintahan': 'text-sky-400',
                    'admin': 'text-rose-500'
                };
                const colorClass = levelColors[camLevel] || 'text-slate-500';
                
                return `
                    <div class="p-4 glass-panel rounded-2xl border ${isSelected ? 'border-emerald-500 bg-emerald-500/10' : 'border-slate-800'} transition flex items-center justify-between" onclick="toggleCameraSelection('${cam.id}')">
                        <div class="flex items-center gap-4 flex-1 min-w-0">
                            <div class="w-10 h-10 bg-slate-950 rounded-xl flex items-center justify-center border border-slate-800 text-slate-700">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-[11px] font-black text-white uppercase truncate">${cam.nama}</h4>
                                    ${!canView ? '<svg class="w-3 h-3 text-rose-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>' : ''}
                                </div>
                                <p class="text-[9px] text-sky-400 font-bold uppercase truncate tracking-wide">${cam.lokasi || 'Live'}</p>
                                <span class="text-[7px] font-black ${colorClass} uppercase tracking-widest mt-1 block">
                                    ${camLevel === 'umum' ? 'UMUM' : camLevel === 'member' ? 'MEMBER' : camLevel.toUpperCase()}
                                </span>
                            </div>
                        </div>
                        ${isSelected ? '<div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse ml-3"></div>' : ''}
                    </div>
                `;
            }).join('');
        }

        // --- Utils ---
        function switchMode(mode) {
            viewMode = mode;
            
            // Update Desktop Tabs
            const tLive = document.getElementById('tab-live');
            const tMap = document.getElementById('tab-map');
            if (tLive) tLive.classList.toggle('active', mode === 'live');
            if (tMap) tMap.classList.toggle('active', mode === 'map');
            if (tLive) tLive.classList.toggle('text-slate-500', mode !== 'live');
            if (tMap) tMap.classList.toggle('text-slate-500', mode !== 'map');

            // Update Mobile Bottom Bar
            const mIconLive = document.getElementById('m-icon-live');
            const mTextLive = document.getElementById('m-text-live');
            const mIconMap = document.getElementById('m-icon-map');
            const mTextMap = document.getElementById('m-text-map');

            if (mode === 'live') {
                if (mIconLive) mIconLive.className = 'p-2 rounded-xl bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300';
                if (mTextLive) mTextLive.className = 'text-[9px] font-black text-emerald-500 uppercase tracking-widest';
                if (mIconMap) mIconMap.className = 'p-2 rounded-xl text-slate-500 transition-all duration-300';
                if (mTextMap) mTextMap.className = 'text-[9px] font-black text-slate-500 uppercase tracking-widest';
            } else {
                if (mIconLive) mIconLive.className = 'p-2 rounded-xl text-slate-500 transition-all duration-300';
                if (mTextLive) mTextLive.className = 'text-[9px] font-black text-slate-500 uppercase tracking-widest';
                if (mIconMap) mIconMap.className = 'p-2 rounded-xl bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300';
                if (mTextMap) mTextMap.className = 'text-[9px] font-black text-emerald-500 uppercase tracking-widest';
            }

            document.getElementById('live-display').classList.toggle('hidden', mode === 'map');
            document.getElementById('map-display').classList.toggle('hidden', mode === 'live');
            
            const mMain = document.getElementById('main-content-display');
            const mList = document.getElementById('mobile-list-container');
            
            if (window.innerWidth < 1024) {
                if (mode === 'map') {
                    mMain.classList.replace('flex-none', 'flex-1');
                    mMain.style.height = 'calc(100vh - 144px)'; // Adjust for header and bottom bar
                    if (mList) mList.classList.add('hidden');
                } else {
                    mMain.classList.replace('flex-1', 'flex-none');
                    mMain.style.height = '';
                    if (mList) mList.classList.remove('hidden');
                }
            }
            
            saveState();
            if (mode === 'map') {
                initMap();
                setTimeout(() => map.invalidateSize(), 300);
            }
        }

        function initMap() {
            if (map) return;
            // Default view (will be overridden if there are cameras)
            map = L.map('map', { zoomControl: false }).setView([-0.8173, 103.4616], 14);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
            }).addTo(map);
            
            const mapBounds = [];
            
            cameras.forEach(cam => {
                if (cam.lat && cam.lng) {
                    mapBounds.push([cam.lat, cam.lng]);
                    const markerIcon = L.divIcon({
                        className: 'custom-div-icon',
                        html: `
                            <div class="relative group">
                                <div class="w-10 h-10 bg-emerald-500 rounded-2xl flex items-center justify-center text-white shadow-2xl border-2 border-white ring-4 ring-emerald-500/20 transform -rotate-45 hover:rotate-0 transition-all duration-500">
                                    <svg class="w-6 h-6 transform rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                                <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-white rounded-full flex items-center justify-center shadow-md">
                                    <div class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></div>
                                </div>
                            </div>
                        `,
                        iconSize: [40, 40],
                        iconAnchor: [20, 20]
                    });
                    
                    const popupContent = `
                        <div class="p-2 min-w-[220px]">
                            <b class="text-slate-900 text-xs block mb-1">${cam.nama}</b>
                            <p class="text-[10px] text-slate-500 mb-2 border-b border-slate-200 pb-2">${cam.lokasi || 'Kuala Tungkal'}</p>
                            
                            <div class="w-full bg-slate-900 rounded-lg overflow-hidden mb-2 aspect-video relative group cursor-pointer" onclick="selectFromMap('${cam.id}')" title="Klik untuk lihat penuh">
                                <video id="popup-video-${cam.id}" class="w-full h-full object-cover" muted autoplay playsinline></video>
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none" id="popup-loading-${cam.id}">
                                    <span class="w-4 h-4 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></span>
                                </div>
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center pointer-events-none">
                                    <span class="text-[10px] font-bold text-white uppercase tracking-widest">Lihat Penuh</span>
                                </div>
                            </div>

                            <div class="weather-data hidden mb-1 grid grid-cols-3 gap-1 text-center" id="popup-weather-${cam.id}">
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Suhu</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-temp-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Angin</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-wind-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Ombak</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-wave-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Arah</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-wave-dir-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Periode</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-wave-period-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Peak</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-wave-peak-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">SST</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-sst-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Arus</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-current-${cam.id}">--</span>
                                </div>
                                <div class="bg-slate-50 p-1 rounded border border-slate-100">
                                    <span class="text-[8px] text-slate-400 block uppercase font-bold">Pasang</span>
                                    <span class="text-[10px] font-black text-slate-700" id="pw-sea-${cam.id}">--</span>
                                </div>
                            </div>
                        </div>
                    `;

                    const marker = L.marker([cam.lat, cam.lng], { icon: markerIcon })
                        .addTo(map)
                        .bindPopup(popupContent, { maxWidth: 260 });

                    marker.on('popupopen', async () => {
                        // 1. Setup Video Stream
                        const videoEl = document.getElementById(`popup-video-${cam.id}`);
                        const loadingEl = document.getElementById(`popup-loading-${cam.id}`);
                        const primaryUrl = `${hlsBase}/cam_${cam.id}/index.m3u8`;
                        const fallbackUrl = `${hlsBase}/cam_${cam.id}_input/index.m3u8`;
                        
                        function startHls(url, isFallback = false) {
                            if (marker.hlsInstance) { marker.hlsInstance.destroy(); marker.hlsInstance = null; }
                            
                            if (window.Hls && Hls.isSupported()) {
                                const hls = new Hls({ manifestLoadingMaxRetry: isFallback ? 5 : 2 });
                                hls.loadSource(url);
                                hls.attachMedia(videoEl);
                                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                                    videoEl.play().catch(e => {});
                                    if (loadingEl) loadingEl.classList.add('hidden');
                                });
                                hls.on(Hls.Events.ERROR, (e, d) => {
                                    if (d.fatal && !isFallback) startHls(fallbackUrl, true);
                                });
                                marker.hlsInstance = hls;
                            } else if (videoEl.canPlayType('application/vnd.apple.mpegurl')) {
                                videoEl.src = url;
                                videoEl.addEventListener('loadedmetadata', () => {
                                    videoEl.play().catch(e => {});
                                    if (loadingEl) loadingEl.classList.add('hidden');
                                });
                            }
                        }
                        
                        startHls(primaryUrl);

                        // 2. Fetch Localized Weather
                        const weatherDiv = document.getElementById(`popup-weather-${cam.id}`);
                        if (!weatherDiv || !weatherDiv.classList.contains('hidden')) return; 

                        try {
                            const res = await fetch(`${basePath}/api/weather`);
                            const data = await res.json();
                            if (data && data.success) {
                                document.getElementById(`pw-temp-${cam.id}`).textContent = data.current ? `${Math.round(data.current.temperature_2m)}°C` : '-';
                                document.getElementById(`pw-wind-${cam.id}`).textContent = data.current ? `${data.current.wind_speed_10m} km/h` : '-';
                                
                                const nowJakarta = new Date().toLocaleString('en-GB', { timeZone: 'Asia/Jakarta', hour12: false });
                                const hourPart = nowJakarta.split(', ')[1].split(':')[0];
                                const nowIdx = parseInt(hourPart, 10);

                                const mh = data.marine_hourly || {};
                                const pick = (arr) => {
                                    if (!Array.isArray(arr) || arr.length === 0) return null;
                                    const v = arr[nowIdx];
                                    if (v !== null && v !== undefined) return v;
                                    const v0 = arr[0];
                                    if (v0 !== null && v0 !== undefined) return v0;
                                    return null;
                                };

                                const waveHeight = pick(mh.wave_height);
                                document.getElementById(`pw-wave-${cam.id}`).textContent = (waveHeight !== null && waveHeight !== undefined) ? `${Number(waveHeight).toFixed(1)}m` : '-';

                                const waveDir = pick(mh.wave_direction);
                                document.getElementById(`pw-wave-dir-${cam.id}`).textContent = (waveDir !== null && waveDir !== undefined) ? `${Math.round(Number(waveDir))}°` : '-';

                                const wavePeriod = pick(mh.wave_period);
                                document.getElementById(`pw-wave-period-${cam.id}`).textContent = (wavePeriod !== null && wavePeriod !== undefined) ? `${Number(wavePeriod).toFixed(1)}s` : '-';

                                const wavePeak = pick(mh.wave_peak_period);
                                document.getElementById(`pw-wave-peak-${cam.id}`).textContent = (wavePeak !== null && wavePeak !== undefined) ? `${Number(wavePeak).toFixed(1)}s` : '-';

                                const sst = pick(mh.sea_surface_temperature);
                                document.getElementById(`pw-sst-${cam.id}`).textContent = (sst !== null && sst !== undefined) ? `${Number(sst).toFixed(1)}°C` : '-';

                                const curVel = pick(mh.ocean_current_velocity);
                                const curDir = pick(mh.ocean_current_direction);
                                if (curVel !== null && curVel !== undefined) {
                                    document.getElementById(`pw-current-${cam.id}`).textContent = `${Number(curVel).toFixed(1)} km/h${(curDir !== null && curDir !== undefined) ? ` • ${Math.round(Number(curDir))}°` : ''}`;
                                } else {
                                    document.getElementById(`pw-current-${cam.id}`).textContent = '-';
                                }

                                const sea = pick(mh.sea_level_height_msl);
                                document.getElementById(`pw-sea-${cam.id}`).textContent = (sea !== null && sea !== undefined) ? `${Number(sea).toFixed(2)} m` : '-';
                                weatherDiv.classList.remove('hidden');
                            }
                        } catch(e) {}
                    });

                    marker.on('popupclose', () => {
                        if (marker.hlsInstance) {
                            marker.hlsInstance.destroy();
                            marker.hlsInstance = null;
                        }
                    });
                }
            });

            if (mapBounds.length > 0) {
                map.fitBounds(mapBounds, { padding: [30, 30], maxZoom: 16 });
            }

            // Trigger resize to fix grey tiles issue
            setTimeout(() => map.invalidateSize(), 300);
        }

        function selectFromMap(id) {
            // If mobile, clear others first for single view
            if (window.innerWidth < 1024) {
                selectedCameraIds = [id];
            } else {
                if (!selectedCameraIds.includes(id)) {
                    selectedCameraIds.push(id);
                }
            }
            saveState();
            switchMode('live');
            saveState();
            updateGrid();
        }

        // --- Weather ---
        async function updateWeather() {
            try {
                const res = await fetch(`${basePath}/api/weather`);
                const data = await res.json();
                if (data && data.success && data.current) {
                    const temp = Math.round(data.current.temperature_2m);
                    const code = data.current.weather_code;
                    
                    document.getElementById('weather-temp').textContent = `${temp}°C`;
                    
                    // Map WMO Codes to Emojis
                    const weatherMap = {
                        0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️',
                        45: '🌫️', 48: '🌫️',
                        51: '🌧️', 53: '🌧️', 55: '🌧️',
                        61: '🌧️', 63: '🌧️', 65: '🌧️',
                        80: '🌦️', 81: '🌦️', 82: '🌦️',
                        95: '⛈️'
                    };
                    document.getElementById('weather-icon').textContent = weatherMap[code] || '🌤️';
                    
                    window.currentWeather = data;
                }
            } catch (e) {
                console.error('Weather update failed', e);
            }
        }

        function showWeatherDetail() {
            const data = window.currentWeather;
            if (!data || !data.current) return;
            
            const content = document.getElementById('modal-weather-content');
            
            // Generate Daily HTML
            let dailyHtml = '';
            if (data.daily) {
                for (let i = 0; i < 7; i++) {
                    const date = new Date(data.daily.time[i]);
                    const dayName = date.toLocaleDateString('id-ID', { weekday: 'short' });
                    const code = data.daily.weather_code[i];
                    const max = Math.round(data.daily.temperature_2m_max[i]);
                    const min = Math.round(data.daily.temperature_2m_min[i]);
                    
                    const weatherMap = { 0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️', 45: '🌫️', 51: '🌧️', 61: '🌧️', 80: '🌦️', 95: '⛈️' };
                    const icon = weatherMap[code] || '🌤️';

                    dailyHtml += `
                        <div class="flex flex-col items-center gap-2 p-2 min-w-[60px]">
                            <span class="text-[10px] font-bold text-slate-500 uppercase">${dayName}</span>
                            <span class="text-2xl">${icon}</span>
                            <div class="flex flex-col items-center">
                                <span class="text-xs font-bold text-white">${max}°</span>
                                <span class="text-[9px] text-slate-500">${min}°</span>
                            </div>
                        </div>
                    `;
                }
            }

            // Generate Hourly HTML (next 12 hours)
            let hourlyHtml = '';
            if (data.hourly) {
                const nowIdx = new Date().getHours();
                for (let i = nowIdx; i < nowIdx + 12; i++) {
                    const hour = i % 24;
                    const temp = Math.round(data.hourly.temperature_2m[i]);
                    const code = data.hourly.weather_code[i];
                    const weatherMap = { 0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️', 45: '🌫️', 51: '🌧️', 61: '🌧️', 80: '🌦️', 95: '⛈️' };
                    const icon = weatherMap[code] || '🌤️';

                    hourlyHtml += `
                        <div class="flex flex-col items-center gap-1 min-w-[50px]">
                            <span class="text-[9px] text-slate-500">${hour.toString().padStart(2, '0')}.00</span>
                            <span class="text-lg">${icon}</span>
                            <span class="text-xs font-bold text-white">${temp}°</span>
                        </div>
                    `;
                }
            }

            content.innerHTML = `
                <div class="flex items-start justify-between mb-2">
                    <div>
                        <h4 class="text-slate-400 text-[10px] font-black uppercase tracking-widest mb-1">Tungkal III, West Tanjung Jabung</h4>
                        <div class="flex items-center gap-4">
                            <span class="text-6xl font-black text-white">${Math.round(data.current.temperature_2m)}°</span>
                            <div class="text-sm text-slate-400">
                                <p>Kelembapan: ${data.current.relative_humidity_2m}%</p>
                                <p>Angin: ${data.current.wind_speed_10m} km/h</p>
                            </div>
                        </div>
                    </div>
                    <div class="text-7xl">${document.getElementById('weather-icon').textContent}</div>
                </div>

                <div class="border-t border-slate-800 pt-6">
                    <p class="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-4">Prakiraan Per Jam</p>
                    <div class="flex gap-4 overflow-x-auto pb-4 no-scrollbar">
                        ${hourlyHtml}
                    </div>
                </div>

                <div class="border-t border-slate-800 pt-6">
                    <p class="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-4">Prakiraan 7 Hari</p>
                    <div class="flex justify-between gap-2 overflow-x-auto pb-2 no-scrollbar">
                        ${dailyHtml}
                    </div>
                </div>
            `;
            
            const modal = document.getElementById('weatherModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeWeatherModal() {
            const modal = document.getElementById('weatherModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // --- Persistence ---
        function saveState() {
            const state = {
                selected: selectedCameraIds,
                mode: viewMode
            };
            localStorage.setItem('cctv_state', JSON.stringify(state));
        }

        function loadState() {
            const saved = localStorage.getItem('cctv_state');
            if (saved) {
                try {
                    const state = JSON.parse(saved);
                    selectedCameraIds = state.selected || [];
                    if (state.mode) {
                        setTimeout(() => switchMode(state.mode), 100);
                    }
                    updateGrid();
                } catch (e) {
                    console.error('Failed to load state', e);
                }
            }
        }

        function toggleFullscreen(id) {
            const el = document.getElementById(id);
            if (!el) return;
            if (el.requestFullscreen) el.requestFullscreen();
            else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
            else if (el.msRequestFullscreen) el.msRequestFullscreen();
        }

        function openReportModal() {
            document.getElementById('reportModal').classList.remove('hidden');
            document.getElementById('reportModal').classList.add('flex');
        }

        function closeReportModal() {
            document.getElementById('reportModal').classList.add('hidden');
            document.getElementById('reportModal').classList.remove('flex');
        }

        document.getElementById('reportForm').onsubmit = async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            try {
                const res = await fetch(`${basePath}/api/reports/submit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    alert('Laporan berhasil dikirim. Terima kasih atas laporannya.');
                    closeReportModal();
                    this.reset();
                } else {
                    alert('Gagal mengirim laporan: ' + result.message);
                }
            } catch (e) {
                alert('Terjadi kesalahan saat mengirim laporan.');
            }
        };

        // --- Search Logic ---
        function filterCameras(term, listId = 'camera-list') {
            term = term.toLowerCase();
            const items = document.querySelectorAll(`#${listId} .camera-item, #${listId} .p-4.glass-panel`);
            items.forEach(item => {
                const name = (item.dataset.nama || item.querySelector('h4')?.textContent || '').toLowerCase();
                const location = (item.querySelector('p')?.textContent || '').toLowerCase();
                const level = (item.querySelector('span')?.textContent || '').toLowerCase();
                const matches = name.includes(term) || location.includes(term) || level.includes(term);
                item.classList.toggle('hidden', !matches);
            });
        }

        document.getElementById('camera-search')?.addEventListener('input', (e) => filterCameras(e.target.value, 'camera-list'));
        document.getElementById('mobile-search')?.addEventListener('input', (e) => filterCameras(e.target.value, 'mobile-camera-list'));

        function updateClock() {
            const now = new Date();
            const options = { timeZone: 'Asia/Jakarta', hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' };
            const timeStr = now.toLocaleTimeString('en-GB', options);
            const dateStr = now.toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta', day: 'numeric', month: 'long', year: 'numeric' });
            
            const clockEl = document.getElementById('topbar-clock');
            const dateEl = document.getElementById('topbar-date');
            const mClockEl = document.getElementById('modal-clock');
            const mDateEl = document.getElementById('modal-date');
            
            if (clockEl) clockEl.textContent = timeStr;
            if (dateEl) dateEl.textContent = dateStr;
            if (mClockEl) mClockEl.textContent = timeStr;
            if (mDateEl) mDateEl.textContent = dateStr;
        }

        function showTimeModal() {
            document.getElementById('timeModal').classList.remove('hidden');
            document.getElementById('timeModal').classList.add('flex');
        }
        function closeTimeModal() {
            document.getElementById('timeModal').classList.add('hidden');
            document.getElementById('timeModal').classList.remove('flex');
        }

        setInterval(updateClock, 1000);
        updateClock();

        window.onload = () => { 
            renderMobileList(); 
            loadState();
            updateWeather();
            setInterval(updateWeather, 300000); // 5 minutes
        };
    </script>
    <script>
        (() => {
            const basePath = '<%= base_path %>' || '';
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register(`${basePath}/sw.js`).catch(() => { });
                });
            }

            let deferredPrompt = null;
            const showBanner = () => {
                if (document.getElementById('pwa-install-banner')) return;
                const banner = document.createElement('div');
                banner.id = 'pwa-install-banner';
                banner.style.cssText = 'position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;display:flex;gap:10px;align-items:center;justify-content:space-between;padding:12px 14px;background:rgba(2,6,23,0.95);border:1px solid rgba(148,163,184,0.25);border-radius:14px;color:#e2e8f0;font:700 12px/1.2 Inter, system-ui, sans-serif;';
                banner.innerHTML = '<div style="display:flex;flex-direction:column;gap:2px"><div style="font-weight:900;letter-spacing:.08em;text-transform:uppercase;font-size:10px;color:#94a3b8">Install</div><div>Pasang aplikasi untuk akses lebih cepat.</div></div><div style="display:flex;gap:8px;flex-shrink:0"><button id="pwa-install-btn" style="padding:8px 10px;border-radius:10px;background:#10b981;color:#020617;border:0;font-weight:900;font-size:12px;cursor:pointer">Install</button><button id="pwa-close-btn" style="padding:8px 10px;border-radius:10px;background:transparent;color:#94a3b8;border:1px solid rgba(148,163,184,0.35);font-weight:900;font-size:12px;cursor:pointer">Tutup</button></div>';
                document.body.appendChild(banner);
                document.getElementById('pwa-close-btn').onclick = () => banner.remove();
                document.getElementById('pwa-install-btn').onclick = async () => {
                    if (!deferredPrompt) return;
                    banner.remove();
                    deferredPrompt.prompt();
                    try { await deferredPrompt.userChoice; } catch { }
                    deferredPrompt = null;
                };
            };

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                showBanner();
            });

            window.addEventListener('appinstalled', () => {
                deferredPrompt = null;
                const b = document.getElementById('pwa-install-banner');
                if (b) b.remove();
            });
        })();
    </script>
</body>
</html>
