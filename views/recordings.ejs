<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Recordings - CCTV</title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <style>
        body {
            background-color: #1a202c;
            color: #e2e8f0;
        }

        .table-row-hover:hover {
            background-color: #2d3748;
        }

        #video-modal {
            display: none;
        }

        /* Timeline Styles */
        .timeline-container {
            position: relative;
            height: 60px;
            background: #1a202c;
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
        }

        .timeline-track {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 4px;
            background: #374151;
            transform: translateY(-50%);
        }

        .timeline-progress {
            position: absolute;
            top: 50%;
            left: 0;
            height: 4px;
            background: #10b981;
            transform: translateY(-50%);
            transition: width 0.1s linear;
        }

        .timeline-segment {
            position: absolute;
            top: 20%;
            height: 60%;
            background: #3b82f6;
            border-radius: 2px;
            opacity: 0.7;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .timeline-segment:hover {
            opacity: 1;
            background: #60a5fa;
        }

        .timeline-cursor {
            position: absolute;
            top: 10%;
            bottom: 10%;
            width: 2px;
            background: #ef4444;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .timeline-time {
            position: absolute;
            bottom: 2px;
            font-size: 10px;
            color: #9ca3af;
            transform: translateX(-50%);
        }

        .timeline-tooltip {
            position: absolute;
            bottom: 100%;
            transform: translateX(-50%);
            background: #1f2937;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
            margin-bottom: 8px;
            border: 1px solid #374151;
        }

        .timeline-segment:hover .timeline-tooltip {
            opacity: 1;
        }

        .date-filter {
            background: #1f2937;
            border: 1px solid #374151;
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            outline: none;
        }

        .date-filter:focus {
            border-color: #10b981;
        }

        .recording-item {
            cursor: pointer;
            transition: all 0.2s;
        }

        /* Mobile: Video player di atas (fixed), list di bawah (scrollable) */
        @media (max-width: 1023px) {
            .mobile-video-container {
                flex: 0 0 auto !important;
                height: 35vh !important;
                min-height: 220px;
                max-height: 40vh;
            }
            
            .mobile-list-container {
                flex: 1 1 0% !important;
                height: auto !important;
                min-height: 0 !important;
                max-height: none !important;
                display: flex !important;
                flex-direction: column !important;
                overflow: hidden !important;
            }
            
            .mobile-list-container > * {
                flex-shrink: 0;
            }
            
            #recordingsList {
                overflow-y: scroll !important;
                -webkit-overflow-scrolling: touch;
                flex: 1 1 auto !important;
                display: block !important;
                min-height: 0 !important;
            }
            
            .recording-row {
                display: block !important;
                visibility: visible !important;
                opacity: 1 !important;
            }
        }

        .recording-item:hover {
            background-color: #374151;
            transform: translateX(4px);
        }

        .recording-item.active {
            background-color: #1e40af;
            border-left: 4px solid #3b82f6;
        }

        .h-screen-dvh {
            height: 100vh;
            height: 100dvh;
        }
    </style>
</head>

<body class="bg-gray-900 min-h-screen text-gray-200 font-sans" data-page-size="<%= typeof pageSize !== 'undefined' ? pageSize : 200 %>">

    <div class="flex h-screen-dvh overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-gray-800 hidden md:flex flex-col border-r border-gray-700">
            <div class="h-16 flex items-center justify-center border-b border-gray-700">
                <h1 class="text-xl font-bold text-green-400 tracking-wider">CCTV ADMIN</h1>
            </div>
            <nav class="flex-1 px-4 py-6 space-y-2">
                <a href="/"
                    class="flex items-center space-x-3 px-4 py-3 rounded hover:bg-gray-700 transition text-gray-400 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z">
                        </path>
                    </svg>
                    <span>Dashboard</span>
                </a>
                <a href="/admin"
                    class="flex items-center space-x-3 px-4 py-3 rounded hover:bg-gray-700 transition text-gray-400 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4">
                        </path>
                    </svg>
                    <span>Configuration</span>
                </a>
                <a href="/admin/recordings"
                    class="flex items-center space-x-3 px-4 py-3 rounded bg-gray-700 text-white shadow-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-2">
                        </path>
                    </svg>
                    <span>Recordings</span>
                </a>
                <a href="/logout"
                    class="flex items-center space-x-3 px-4 py-3 rounded hover:bg-red-900/30 text-red-400 hover:text-red-300 transition mt-auto">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                        </path>
                    </svg>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden">
            <header
                class="h-16 bg-gray-800 border-b border-gray-700 flex items-center justify-between px-8 shadow-sm md:hidden">
                <h1 class="text-lg font-bold text-green-400">CCTV Recordings</h1>
                <div class="flex items-center gap-4">
                    <a href="/admin/recordings" class="text-white text-sm">Recordings</a>
                    <a href="/logout" class="text-red-400 hover:text-red-300 text-sm">Logout</a>
                </div>
            </header>

            <!-- Two Column Layout: Video Player (Kiri) + List Rekaman (Kanan) -->
            <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">
                <!-- Recordings List (Mobile: di bawah, Desktop: di kanan) -->
                <div class="mobile-list-container lg:w-80 lg:max-w-[20%] flex flex-col bg-gray-800 border-t lg:border-t-0 lg:border-l border-gray-700 order-2 lg:order-2 min-h-0">
                    <div class="p-4 lg:p-6 border-b border-gray-700">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                                <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-2">
                                    </path>
                                </svg>
                                Daftar Rekaman
                            </h2>
                            <span class="text-sm text-gray-400 px-3 py-1 bg-gray-700 rounded-full border border-gray-600">
                                <%= typeof totalCount !== 'undefined' ? totalCount : recordings.length %> File
                            </span>
                        </div>

                        <!-- Filters -->
                        <div class="flex flex-col sm:flex-row gap-2">
                            <input type="date" id="dateFilter" class="date-filter flex-1"
                                onchange="applyDateServerFilter()"
                                value="<%= typeof filterDate !== 'undefined' ? filterDate : '' %>">
                            <select id="cameraFilter" class="date-filter flex-1" onchange="filterByCamera()">
                                <option value="">Semua Kamera</option>
                                <% 
                                    const camPairs = [];
                                    const seenKeys = new Set();
                                    (recordings || []).forEach(function(r) {
                                        var val = r.camera_folder || r.camera_name;
                                        var labelCam = r.camera_name || val;
                                        var labelFolder = r.camera_folder || val;
                                        if (!seenKeys.has(val)) {
                                            seenKeys.add(val);
                                            camPairs.push({ value: val, label: labelFolder + ' — ' + labelCam });
                                        }
                                    });
                                    camPairs.forEach(function(item) { 
                                %>
                                    <option value="<%= item.value %>"><%= item.label %></option>
                                <% }); %>
                            </select>
                            <input type="text" id="nameFilter" class="date-filter flex-1" placeholder="Cari nama file"
                                oninput="filterByName()">
                        </div>

                        <div class="flex items-center justify-between text-xs text-gray-400 mt-3">
                            <span>
                                Halaman <%= typeof currentPage !== 'undefined' ? currentPage : 1 %> / <%= typeof totalPages !== 'undefined' ? totalPages : 1 %>
                            </span>
                            <span>
                                <%= recordings.length %> dari <%= typeof totalCount !== 'undefined' ? totalCount : recordings.length %> file
                            </span>
                        </div>
                    </div>

                    <!-- Recordings List -->
                    <div class="flex-1 overflow-y-auto min-h-0" id="recordingsList">
                        <div id="recordingsBody">
                            <% recordings.forEach(function(rec) { %>
                                <div class="recording-item recording-row border-b border-gray-700 p-4 hover:bg-gray-700"
                                    data-camera="<%= rec.camera_folder || rec.camera_name %>"
                                    data-time="<%= rec.created_at_iso || rec.created_at %>"
                                    data-filename="<%= rec.filename || rec.file_path %>"
                                    data-file="/<%= rec.file_path %>"
                                    data-id="<%= rec.id %>"
                                    onclick="playVideoInline('/<%= rec.file_path %>', '<%= rec.camera_name %>', '<%= rec.created_at_iso || rec.created_at %>', this)">
                                    <div class="flex items-start gap-3">
                                        <div class="flex-shrink-0 relative w-20 h-14 bg-gray-800 rounded-lg overflow-hidden border border-gray-700 flex items-center justify-center group-hover:border-gray-500 transition-colors">
                                            <svg class="absolute w-6 h-6 text-gray-600 z-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"></path>
                                            </svg>
                                            <img src="/thumbnail?path=<%= encodeURIComponent(rec.file_path) %>" class="absolute inset-0 w-full h-full object-cover z-10 opacity-90 group-hover:opacity-100 transition-opacity" loading="lazy" onerror="this.style.display='none'" alt="">
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="text-white font-medium truncate"><%= rec.camera_name %></h3>
                                            <p class="text-gray-400 text-sm truncate"><%= rec.filename || rec.file_path %></p>
                                            <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                                                <span><%= new Date(rec.created_at_iso || rec.created_at).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', dateStyle: 'short', timeStyle: 'short' }) %></span>
                                                <span>•</span>
                                                <span><%= (rec.size / (1024 * 1024)).toFixed(1) %> MB</span>
                                                <% if (rec.duration) { %>
                                                    <span>•</span>
                                                    <span><%= rec.duration %>s</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0 flex gap-1">
                                            <a href="/<%= rec.file_path %>" download
                                                class="p-2 bg-green-600 hover:bg-green-700 text-white rounded transition"
                                                onclick="event.stopPropagation()"
                                                title="Download">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4">
                                                    </path>
                                                </svg>
                                            </a>
                                            <button onclick="event.stopPropagation(); deleteRecording('<%= rec.id %>')"
                                                class="p-2 bg-red-600/20 hover:bg-red-600 text-red-400 hover:text-white rounded transition"
                                                title="Hapus">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                    </path>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <div id="noRecordings" class="hidden p-8 text-center text-gray-500 italic">
                            Tidak ada rekaman untuk filter yang dipilih.
                        </div>
                    </div>

                    <!-- Pagination -->
                    <div class="border-t border-gray-700 p-4 bg-gray-800">
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
                            <div class="flex items-center gap-2">
                                <% const sizeParam = (typeof pageSize !== 'undefined' ? pageSize : 200); %>
                                <% const pageParam = (typeof currentPage !== 'undefined' ? currentPage : 1); %>
                                <% const totalPagesParam = (typeof totalPages !== 'undefined' ? totalPages : 1); %>
                                <% const prevPage = Math.max(1, pageParam - 1); %>
                                <% const nextPage = Math.min(totalPagesParam, pageParam + 1); %>
                                <% const dateParam = (typeof filterDate !== 'undefined' ? filterDate : ''); %>
                                <% const baseQuery = `size=${sizeParam}` + (dateParam ? `&date=${dateParam}` : ''); %>
                                <a href="/admin/recordings?<%= baseQuery %>&page=<%= prevPage %>"
                                    class="bg-gray-700 hover:bg-gray-600 px-4 py-2 rounded border border-gray-600 <%= pageParam <= 1 ? 'opacity-50 pointer-events-none' : '' %>">
                                    ← Sebelumnya
                                </a>
                                <a href="/admin/recordings?<%= baseQuery %>&page=<%= nextPage %>"
                                    class="bg-gray-700 hover:bg-gray-600 px-4 py-2 rounded border border-gray-600 <%= pageParam >= totalPagesParam ? 'opacity-50 pointer-events-none' : '' %>">
                                    Berikutnya →
                                </a>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-gray-400">Per halaman:</span>
                                <% const sizes = [100, 200, 300, 500]; %>
                                <% sizes.forEach(function(s) { %>
                                    <a href="/admin/recordings?<%= (dateParam ? `date=${dateParam}&` : '') %>size=<%= s %>&page=1"
                                        class="px-3 py-1 rounded border <%= sizeParam === s ? 'bg-green-600 text-white border-green-600' : 'bg-gray-700 hover:bg-gray-600 border-gray-600' %>">
                                        <%= s %>
                                    </a>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Video Player (Mobile: di atas, Desktop: di kiri) -->
                <div class="mobile-video-container flex-1 bg-gray-900 flex flex-col order-1 lg:order-1">
                    <div class="p-4 border-b border-gray-700">
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z">
                                </path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Video Player
                        </h2>
                        <p class="text-sm text-gray-400 mt-1">Klik file rekaman untuk memutar video</p>
                    </div>
                    
                    <div class="flex-1 flex flex-col bg-black relative overflow-hidden">
                        <div id="player-container" class="flex-1 flex items-center justify-center">
                            <div id="player-placeholder" class="text-center p-8">
                                <svg class="w-32 h-32 mx-auto text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z">
                                    </path>
                                </svg>
                                <p class="text-gray-500 text-xl font-medium">Pilih rekaman untuk diputar</p>
                                <p class="text-gray-600 text-sm mt-2">Video akan ditampilkan di sini</p>
                            </div>
                            <video id="inline-player" class="hidden w-full h-full object-contain" controls autoplay>
                                Browser Anda tidak mendukung pemutar video ini.
                            </video>
                            <div id="inline-video-error"
                                class="hidden absolute inset-0 flex flex-col items-center justify-center bg-gray-900 text-center p-6">
                                <svg class="w-16 h-16 text-red-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <p class="text-white font-semibold mb-2 text-lg">Gagal Memutar Video</p>
                                <p class="text-gray-400 text-sm mb-4">Codec video mungkin tidak didukung. Gunakan Safari atau download untuk VLC.</p>
                                <a id="inline-error-download-link" href="#" download
                                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded text-sm transition">
                                    Download Video
                                </a>
                            </div>
                        </div>
                        
                        <!-- Video Controls Bar -->
                        <div id="video-controls-bar" class="hidden bg-gray-800 border-t border-gray-700 p-4 relative z-50">
                            <div class="flex items-center justify-between gap-3">
                                <div class="flex-1 min-w-0">
                                    <p class="text-white font-medium truncate text-lg" id="current-video-title">-</p>
                                    <p class="text-gray-400 text-sm truncate" id="current-video-info">-</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="flex items-center gap-2">
                                        <span class="text-gray-400 text-sm">Speed:</span>
                                        <select id="inline-playback-rate"
                                            class="bg-gray-700 border border-gray-600 rounded px-3 py-2 text-sm text-gray-100"
                                            onchange="changeInlinePlaybackRate(this.value)">
                                            <option value="0.5">0.5x</option>
                                            <option value="1" selected>1x</option>
                                            <option value="1.5">1.5x</option>
                                            <option value="2">2x</option>
                                        </select>
                                    </div>
                                    <button onclick="openInModal()"
                                        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition flex items-center gap-2"
                                        title="Buka di modal fullscreen">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4">
                                            </path>
                                        </svg>
                                        <span>Fullscreen</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Video Modal (Fullscreen) -->
    <div id="video-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-90 p-2 sm:p-4">
        <div id="modal-video-card"
            class="relative w-full max-w-4xl max-h-[85vh] flex flex-col bg-gray-800 rounded-lg overflow-y-auto shadow-2xl">
            <div class="sticky top-0 z-10 p-3 sm:p-4 bg-gray-900 border-b border-gray-700 flex justify-between items-center gap-2">
                <div>
                    <h3 class="text-white font-bold" id="videoTitle">Pemutar Video Rekaman</h3>
                    <p class="text-sm text-gray-400" id="videoInfo"></p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1 text-xs text-gray-300">
                        <span>Speed</span>
                        <select id="playbackRateSelect"
                            class="bg-gray-800 border border-gray-700 rounded px-2 py-1 text-xs text-gray-100"
                            onchange="changePlaybackRate(this.value)">
                            <option value="0.5">0.5x</option>
                            <option value="1" selected>1x</option>
                            <option value="1.5">1.5x</option>
                            <option value="2">2x</option>
                        </select>
                    </div>
                    <button onclick="closeModal()"
                        class="min-w-[44px] min-h-[44px] flex items-center gap-2 justify-center bg-red-600 hover:bg-red-700 text-white p-2 rounded touch-manipulation">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12">
                            </path>
                        </svg>
                        <span class="hidden sm:inline text-xs font-semibold">TUTUP</span>
                    </button>
                </div>
            </div>
            <div class="aspect-video bg-black flex items-center justify-center relative max-h-[50vh]">
                <video id="modal-player" class="w-full h-full object-contain" controls autoplay>
                    Browser Anda tidak mendukung pemutar video ini.
                </video>
                <div id="video-error"
                    class="hidden absolute inset-0 flex flex-col items-center justify-center bg-gray-900 text-center p-6">
                    <svg class="w-12 h-12 text-red-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <p class="text-white font-semibold mb-2">Gagal Memutar Video</p>
                    <p class="text-gray-400 text-sm mb-4">Codec video (H.265/HEVC) mungkin tidak didukung oleh browser
                        ini. Silakan gunakan Safari atau download file untuk diputar di VLC.</p>
                    <a id="error-download-link" href="#" download
                        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm transition">
                        Download Video
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const modal = document.getElementById('video-modal');
        const modalPlayer = document.getElementById('modal-player');
        const inlinePlayer = document.getElementById('inline-player');
        let currentRecording = null;
        let currentActiveItem = null;

        // Get recordings data from server-rendered list
        let allRecordings = [];
        document.querySelectorAll('.recording-row').forEach(row => {
            allRecordings.push({
                id: row.dataset.id,
                camera_name: row.dataset.camera,
                created_at: row.dataset.time,
                filename: row.dataset.filename,
                file_path: row.dataset.file?.substring(1),
                size: 0
            });
        });
        let filteredRecordings = [...allRecordings];

        document.addEventListener('DOMContentLoaded', () => {
            const dateInput = document.getElementById('dateFilter');
            if (!dateInput.value && allRecordings.length > 0) {
                const sorted = [...allRecordings].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
                dateInput.valueAsDate = new Date(sorted[0].created_at);
            } else if (!dateInput.value) {
                dateInput.valueAsDate = new Date();
            }
            filterByDate();
        });

        function applyDateServerFilter() {
            const dateFilter = document.getElementById('dateFilter').value;
            const pageSizeParam = Number(document.body.dataset.pageSize || '200');
            const url = new URL(window.location.href);
            if (dateFilter) {
                url.searchParams.set('date', dateFilter);
            } else {
                url.searchParams.delete('date');
            }
            url.searchParams.set('page', '1');
            url.searchParams.set('size', String(pageSizeParam));
            window.location.href = url.pathname + '?' + url.searchParams.toString();
        }

        // Play video inline
        function playVideoInline(url, cameraName, createdAt, element) {
            currentRecording = { url, cameraName, createdAt };

            // Update active state
            if (currentActiveItem) {
                currentActiveItem.classList.remove('active');
            }
            element.classList.add('active');
            currentActiveItem = element;

            // Reset UI
            document.getElementById('inline-video-error').classList.add('hidden');
            document.getElementById('player-placeholder').classList.add('hidden');
            inlinePlayer.classList.remove('hidden');
            document.getElementById('video-controls-bar').classList.remove('hidden');

            inlinePlayer.src = url;

            const rateSelect = document.getElementById('inline-playback-rate');
            if (rateSelect) {
                rateSelect.value = '1';
            }
            inlinePlayer.playbackRate = 1;

            document.getElementById('current-video-title').textContent = cameraName || 'Video Recording';
            document.getElementById('current-video-info').textContent = createdAt ? new Date(createdAt).toLocaleString('id-ID') : '';
            document.getElementById('inline-error-download-link').href = url;

            inlinePlayer.play().catch(e => {
                console.error("Playback failed:", e);
            });

            // Error handling
            inlinePlayer.onerror = () => {
                document.getElementById('inline-video-error').classList.remove('hidden');
                inlinePlayer.classList.add('hidden');
            };
        }

        function playNextRecording() {
            if (!currentActiveItem) return;
            let nextItem = currentActiveItem.nextElementSibling;
            while (nextItem) {
                if (nextItem.classList.contains('recording-item') && nextItem.style.display !== 'none') {
                    nextItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    nextItem.click();
                    return;
                }
                nextItem = nextItem.nextElementSibling;
            }
        }

        inlinePlayer.addEventListener('ended', playNextRecording);
        modalPlayer.addEventListener('ended', playNextRecording);

        function changeInlinePlaybackRate(rate) {
            const value = parseFloat(rate);
            if (inlinePlayer && !isNaN(value) && value > 0) {
                inlinePlayer.playbackRate = value;
            }
        }

        function openInModal() {
            if (!currentRecording) return;
            
            // Pause inline player
            inlinePlayer.pause();
            
            // Open modal with same video
            modalPlayer.src = currentRecording.url;
            modal.style.display = 'flex';

            const rateSelect = document.getElementById('playbackRateSelect');
            if (rateSelect) {
                rateSelect.value = '1';
            }
            modalPlayer.playbackRate = 1;

            document.getElementById('videoTitle').textContent = currentRecording.cameraName || 'Video Recording';
            document.getElementById('videoInfo').textContent = currentRecording.createdAt ? new Date(currentRecording.createdAt).toLocaleString('id-ID') : '';
            document.getElementById('error-download-link').href = currentRecording.url;

            modalPlayer.play().catch(e => {
                console.error("Playback failed:", e);
            });

            // Error handling
            modalPlayer.onerror = () => {
                document.getElementById('video-error').classList.remove('hidden');
                document.getElementById('modal-player').classList.add('hidden');
            };
        }

        function changePlaybackRate(rate) {
            const value = parseFloat(rate);
            if (modalPlayer && !isNaN(value) && value > 0) {
                modalPlayer.playbackRate = value;
            }
        }

        function closeModal() {
            if (document.fullscreenElement) document.exitFullscreen();
            modal.style.display = 'none';
            modalPlayer.pause();
            modalPlayer.src = "";
            
            // Resume inline player if there was a video playing
            if (currentRecording && inlinePlayer.src) {
                inlinePlayer.play().catch(e => {});
            }
        }

        // Filter by date
        function filterByDate() {
            const dateFilter = document.getElementById('dateFilter').value;
            const cameraFilter = document.getElementById('cameraFilter').value;
            const nameFilter = document.getElementById('nameFilter').value;
            applyFilters(dateFilter, cameraFilter, nameFilter);
        }

        // Filter by camera
        function filterByCamera() {
            const dateFilter = document.getElementById('dateFilter').value;
            const cameraFilter = document.getElementById('cameraFilter').value;
            const nameFilter = document.getElementById('nameFilter').value;
            applyFilters(dateFilter, cameraFilter, nameFilter);
        }

        function filterByName() {
            const dateFilter = document.getElementById('dateFilter').value;
            const cameraFilter = document.getElementById('cameraFilter').value;
            const nameFilter = document.getElementById('nameFilter').value;
            applyFilters(dateFilter, cameraFilter, nameFilter);
        }

        function applyFilters(dateFilter, cameraFilter, nameFilter) {
            filteredRecordings = allRecordings.filter(rec => {
                let matchDate = true;
                let matchCamera = true;
                let matchName = true;

                if (dateFilter) {
                    const recDate = new Date(rec.created_at).toDateString();
                    const filterDate = new Date(dateFilter).toDateString();
                    matchDate = recDate === filterDate;
                }

                if (cameraFilter) {
                    matchCamera = (rec.camera_folder || rec.camera_name) === cameraFilter;
                }

                if (nameFilter) {
                    const needle = nameFilter.toLowerCase();
                    const hay = String(rec.filename || rec.file_path || '').toLowerCase();
                    matchName = hay.includes(needle);
                }

                return matchDate && matchCamera && matchName;
            });

            // Update list visibility
            const rows = document.querySelectorAll('.recording-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const camera = row.dataset.camera;
                const time = row.dataset.time;
                const filename = row.dataset.filename || '';

                let show = true;
                if (cameraFilter && camera !== cameraFilter) show = false;
                if (dateFilter) {
                    const rowDate = new Date(time).toDateString();
                    const filterDate = new Date(dateFilter).toDateString();
                    if (rowDate !== filterDate) show = false;
                }
                if (nameFilter) {
                    const needle = nameFilter.toLowerCase();
                    if (!filename.toLowerCase().includes(needle)) show = false;
                }

                row.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            const noRecordingsEl = document.getElementById('noRecordings');
            if (noRecordingsEl) {
                noRecordingsEl.style.display = visibleCount === 0 ? 'block' : 'none';
            }
            
            console.log('Visible recordings:', visibleCount);
        }
        
        // Pastikan semua data ditampilkan saat load
        document.addEventListener('DOMContentLoaded', () => {
            const rows = document.querySelectorAll('.recording-row');
            rows.forEach(row => {
                row.style.display = '';
            });
            console.log('Total recordings loaded:', rows.length);
        });

        async function deleteRecording(id) {
            if (!confirm('Hapus file rekaman ini secara permanen?')) return;
            try {
                const res = await fetch('/api/recordings/' + id, { method: 'DELETE' });
                if (res.ok) window.location.reload();
                else alert('Gagal menghapus rekaman');
            } catch (e) {
                alert('Kesalahan koneksi');
            }
        }

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    </script>
</body>

</html>